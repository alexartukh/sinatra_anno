<div class="center_box">
<h1>Public Data</h1>
<table class="cool_table">
    <tr>
        <th>
            #
        </th>
        <th>
            File
        </th>
        <th>
            Type
        </th>
        <th>
            Annotated
        </th>
    </tr>    
<% public_files.each_with_index do |public_file, index| %>
    <tr>
        <td>
        <%= index + 1 %>. 
        </td>
        <td>
        <a href="/show_data_file/<%= public_file %>/">
            <%= public_file %>
        </a>
        </td>
        <td>
            <%= public_file_extensions[index] %>
        </td>
        <td>
            <a href="/mine_data/1/<%= public_file %>/">
                [OPEN]
            </a>
        </td>
    </tr>
<% end %>
</table>
</div>